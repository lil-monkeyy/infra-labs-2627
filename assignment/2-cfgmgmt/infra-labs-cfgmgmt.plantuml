@startuml infra-labs-cfgmgmt

' System admin and end-user actors
actor Ops
actor User

' DMZ network with public-facing services
frame dmz {
    ' DNS server for the infra.lan domain
    node dmz003 {
        [dns1]
    }
    ' Web server
    node dmz010 {
        [reverse_proxy]
        [app1]
        [app2]
        [app3]
    }
    ' Database server
    node dmz020 {
        database db
    }
}

' Internal network with control and infrastructure nodes
frame internal {
    ' Ansible control node
    node control {
        [ssh]
    }
    ' Stealth DNS server
    node infra003 {
        [dns2]
    }
    ' Jenkins build server
    node infra010 {
        [jenkins]
    }
}

' Communication between components

' Ops will SSH into the control node as the main way to manage the
' infrastructure
Ops --> ssh : :ssh
Ops --> jenkins : :9000

' Jenkins deploys the web application to the DMZ web server
jenkins --> dmz010

' End-users will access the public website through the reverse proxy, which
' will distribute the requests to the web applications, which will query the database
User -[bold;#green]-> reverse_proxy : :https

reverse_proxy -[bold;#green]-> app1 : :http
reverse_proxy -[bold;#green]-> app2 : :http
reverse_proxy -[bold;#green]-> app3 : :http

app1 -[bold;#green]-> db : :mysql
app2 -[bold;#green]-> db : :mysql
app3 -[bold;#green]-> db : :mysql

@enduml